# Configuración de Base de Datos MySQL (Docker)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mapa_marciano
DB_USER=root
DB_PASSWORD=root_password

# Puerto del Servidor Backend Node.js
PORT=4000
